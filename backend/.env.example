# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# --- LLM provider (Story layer only) ---
# Story layer LLMClient abstraction supports "openai" and "ollama".
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL_CHEAP=gpt-4o-mini
OPENAI_MODEL_STRONG=gpt-4o

# Optional local fallback tier (no key required, used if LLM_PROVIDER=ollama
# or as an automatic fallback when OPENAI_API_KEY is unset)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_CHEAP=qwen2.5:1.5b
OLLAMA_MODEL_STRONG=qwen2.5:3b

# --- Data ---
DATA_RAW_DIR=../data/raw
DATA_PROCESSED_DIR=../data/processed

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- Confidence / abstention thresholds (see services/reasoning/confidence.py) ---
CONFIDENCE_ABSTAIN_MARGIN=0.12
CONFIDENCE_LOW_THRESHOLD=0.55
CONFIDENCE_HIGH_THRESHOLD=0.75

# --- Cost tiering ---
LLM_TIER_CONFIDENCE_CUTOFF=0.75
